#!/usr/bin/python3 -I
"""Launcher: runs secdepmap from the repository it lives in.

-I (isolated mode) ignores PYTHON* environment variables and the user site
directory and does not put the CWD on sys.path, so running this as root
cannot be hijacked through the caller's environment or working directory.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from secdepmap.cli import main  # noqa: E402

sys.exit(main())
